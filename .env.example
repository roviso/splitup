# Copy to .env and fill in. Never commit .env.

# Database (production compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Email for login codes. Leave SMTP_HOST empty in dev: codes are printed in the API log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@thimitech.com
SMTP_PASS=
MAIL_FROM=Split-Up <no-reply@thimitech.com>

# Optional "Continue with Google". Create an OAuth Web client at console.cloud.google.com and add
# Authorized redirect URIs: https://splitup.thimitech.com/api/auth/google/callback
#                           http://localhost:5173/api/auth/google/callback   (dev)
# Without the secret, the app falls back to Google's in-page button (needs Authorized JavaScript origins instead).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the public URL differs from the Host header nginx passes on, e.g. https://splitup.thimitech.com
APP_URL=

# Optional AI: scan bill photos and split by chatting. Bill photos and names of the people on a bill go to OpenAI.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
