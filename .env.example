# Copy to .env and fill in. Never commit .env.

# Database (production compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Email for login codes. Leave SMTP_HOST empty in dev: codes are printed in the API log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@thimitech.com
SMTP_PASS=
MAIL_FROM=Split-Up <no-reply@thimitech.com>

# Optional "Continue with Google". Create an OAuth Web client at console.cloud.google.com,
# add https://splitup.thimitech.com (and http://localhost:5173) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
